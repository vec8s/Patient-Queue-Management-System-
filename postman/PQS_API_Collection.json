    {
      "name": "03. Appointments Management",
      "item": [
        {
          "name": "Book New Appointment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var tomorrow = new Date();",
                  "tomorrow.setDate(tomorrow.getDate() + 1);",
                  "var dateStr = tomorrow.toISOString().split('T')[0];",
                  "pm.environment.set(\"test_appt_date\", dateStr);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Appointment booked with reference number\", function () {",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    var ref = jsonData.data.appointmentID || (jsonData.data.appointment && jsonData.data.appointment.reference_number);",
                  "    pm.expect(ref).to.be.a(\"string\");",
                  "    pm.environment.set(\"appointment_ref\", ref);",
                  "    console.log(\"Saved appointment_ref:\", ref);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"patient_id\": \"{{patient_id}}\",\n    \"doctor_id\": 2,\n    \"appointment_date\": \"{{test_appt_date}}\",\n    \"appointment_time\": \"11:00:00\",\n    \"notes\": \"استشارة طبية وفحص دوري\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/appointments.php",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "appointments.php"]
            },
            "description": "Books a scheduled appointment and saves the generated reference number to {{appointment_ref}}."
          }
        },
        {
          "name": "Lookup Appointment by Reference Number",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Appointment details matched reference\", function () {",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.data.appointment).to.be.an(\"object\");",
                  "    pm.expect(jsonData.data.appointment.reference_number).to.eql(pm.environment.get(\"appointment_ref\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/appointments.php?appointmentID={{appointment_ref}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "appointments.php"],
              "query": [
                {
                  "key": "appointmentID",
                  "value": "{{appointment_ref}}"
                }
              ]
            },
            "description": "Retrieves appointment details and patient info using the reference code."
          }
        }
      ]
    },
