        {
          "name": "Register New Staff (Admin Only)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomSuffix = Math.floor(1000 + Math.random() * 9000);",
                  "pm.environment.set(\"new_staff_email\", \"nurse_\" + randomSuffix + \"@clinic.local\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Staff created successfully by Admin\", function () {",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.data.staff_id).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
