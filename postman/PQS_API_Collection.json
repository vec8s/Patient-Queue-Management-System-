              "query": [
                {
                  "key": "action",
                  "value": "login"
                }
              ]
            },
            "description": "Verifies that incorrect credentials trigger 401 Unauthorized."
          }
        },
        {
          "name": "Logout Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
