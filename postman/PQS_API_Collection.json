            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"action\": \"register\",\n    \"firstName\": \"مريم\",\n    \"lastName\": \"السالم\",\n    \"email\": \"{{new_staff_email}}\",\n    \"password\": \"Nurse@123\",\n    \"role\": \"nurse\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth.php?action=register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth.php"],
              "query": [
                {
                  "key": "action",
                  "value": "register"
                }
              ]
