    {
      "name": "02. Patients Management",
      "item": [
        {
          "name": "Register New Patient",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomNatId = \"10\" + Math.floor(10000000 + Math.random() * 90000000);",
                  "var randomPhone = \"05\" + Math.floor(10000000 + Math.random() * 90000000);",
                  "pm.environment.set(\"test_national_id\", randomNatId);",
                  "pm.environment.set(\"test_phone\", randomPhone);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Patient registered with valid ID\", function () {",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.data.patient_id).to.be.above(0);",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.patient_id) {",
                  "    pm.environment.set(\"patient_id\", jsonData.data.patient_id);",
                  "    console.log(\"Saved patient_id to environment:\", jsonData.data.patient_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"national_id\": \"{{test_national_id}}\",\n    \"first_name\": \"سلطان\",\n    \"last_name\": \"العتيبي\",\n    \"phone\": \"{{test_phone}}\",\n    \"gender\": \"male\",\n    \"dob\": \"1992-04-15\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/patients.php",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "patients.php"]
            },
            "description": "Registers a new patient and saves patient_id to environment."
          }
        },
