{
  "info": {
    "_postman_id": "pqs-collection-v1",
    "name": "Patient Queue Management System (PQS) API",
    "description": "Comprehensive automated testing & inspection collection for PQS (Patient Queue Management System).\n\nIncludes:\n- 01. Authentication & Staff Management (RBAC JWT)\n- 02. Patients Management (Register & Search)\n- 03. Appointments Management (Booking & Lookup)\n- 04. Queue & TV Display Management (Live Queue, Walk-in, Consultation Flow)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Authentication & Staff",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response returns success status and JWT token\", function () {",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.data).to.be.an(\"object\");",
                  "    pm.expect(jsonData.data.token).to.be.a(\"string\");",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Saved Admin token to environment variable: token\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"action\": \"login\",\n    \"email\": \"{{admin_email}}\",\n    \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth.php?action=login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth.php"],
              "query": [
                {
                  "key": "action",
                  "value": "login"
                }
              ]
            },
            "description": "Authenticates as Admin and automatically extracts JWT token into {{token}}."
          }
        },
        {
          "name": "Doctor Login",
          "event": [
            {
              "listen": "test",
              "script": {
