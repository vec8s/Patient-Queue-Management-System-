# ========================================================
# PQS Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ========================================================

# Application Settings
APP_NAME="Patient Queue Management System"
APP_SHORT_NAME="PQS"
APP_VERSION="3.0.0"
APP_ENV="production"
APP_DEBUG=false
APP_TIMEZONE="UTC"

# Database Connection
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASS=""
DB_NAME="db_pqs"

# JWT Security
JWT_SECRET="replace_with_a_cryptographically_secure_random_key_min_32_chars"
JWT_ALGORITHM="HS256"
JWT_EXPIRY=86400

